{
  "name": "mail-temp",
  "version": "1.0.0",
  "description": "Local operator console for the Hotmail to ElevenLabs automation pipeline",
  "main": "signup-hotmail.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config vite.config.mts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config vite.config.mts",
    "start": "node dist/server/index.js",
    "test": "npm run test:syntax && npm run test:typecheck && node test/run-all.js && vitest run",
    "test:syntax": "node test/check-root-syntax.js",
    "test:typecheck": "tsc -p tsconfig.server-tests.json && tsc -p tsconfig.web.json",
    "test:legacy": "node test/run-all.js",
    "test:new": "vitest run",
    "batch": "node batch.js",
    "signup:catchall": "node catch-all-signup/index.js",
    "generate:catchall": "node catch-all-signup/email-generator.js",
    "trial:gpt": "node trial-gpt/index.js",
    "reg:gmail": "node reg-gmail/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "imap-simple": "^5.1.0",
    "lucide-react": "^1.33.0",
    "mailparser": "^3.9.20",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "playwright-extra-plugin-stealth": "^0.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
